APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database Configuration
# Opsi 1: PostgreSQL (Standar Baru SIPERAPAT)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=siperapat_db
DB_USERNAME=siperapat_user
DB_PASSWORD=secret_password
DB_SCHEMA=public
DB_SSLMODE=prefer

# Opsi 2: MySQL / MariaDB (Legacy / Alternatif)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=lldikti_db
# DB_USERNAME=root
# DB_PASSWORD=
# DB_SOCKET=

# Driver Sesi & Cache
# Opsi 1: database (Default Ponytail/Gov-Tech: mandiri, tabel sessions/cache/cache_locks sudah tersedia)
# Opsi 2: redis (High-Performance: memerlukan ekstensi OS sudo apt install php-redis & redis-server)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# Konfigurasi Redis (Dipakai jika SESSION_DRIVER=redis, CACHE_STORE=redis, atau QUEUE_CONNECTION=redis)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Konfigurasi Pengiriman Email Kedinasan (Brevo / Sendinblue Transactional Email)
# Opsi 1: Brevo SMTP Relay - Port 465 SSL/SMTPS (Rekomendasi Utama Produksi - Solusi jika Port 587 diblokir firewall hosting/VPS)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=465
MAIL_USERNAME=your-brevo-smtp-login-email
MAIL_PASSWORD=your-brevo-smtp-key
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@lldiktiwilayahx.kemdiktisaintek.go.id
MAIL_FROM_NAME="SIPERAPAT LLDIKTI Wilayah X"

# Opsi 2: Brevo SMTP Relay - Port 587 STARTTLS (Gunakan jika server Anda mengizinkan lalu lintas port 587)
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-brevo-smtp-login-email
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS=noreply@lldiktiwilayahx.kemdiktisaintek.go.id
# MAIL_FROM_NAME="SIPERAPAT LLDIKTI Wilayah X"

# Opsi 3: Brevo HTTP API v3 (HTTPS Port 443 - Otomatis aktif jika MAIL_MAILER=brevo atau password berawalan xkeysib-...)
# BREVO_API_KEY=xkeysib-your-brevo-v3-api-key

# Opsi 4: Pengujian Lokal Tanpa Pengiriman Email Riil (Gunakan 'log' untuk menulis email ke storage/logs/laravel.log)
# MAIL_MAILER=log

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Ekspor PDF (LibreOffice headless) ---
# Jumlah konversi PDF yang boleh berjalan bersamaan. Setiap slot memiliki profil
# LibreOffice sendiri yang menetap antar permintaan, sehingga nilai ini sekaligus
# menentukan berapa banyak profil yang sudah "hangat". Naikkan hanya bila CPU dan
# RAM server memang cukup.
PDF_EXPORT_SLOTS=2

# Berapa lama permintaan menunggu slot kosong sebelum menampilkan pesan sibuk.
PDF_EXPORT_SLOT_WAIT=20

# Batas waktu satu proses konversi, dalam detik.
PDF_EXPORT_TIMEOUT=60

# Lama hasil probe ketersediaan LibreOffice dipakai ulang, dalam detik.
PDF_EXPORT_PROBE_CACHE=300
